        "integration",
        "statusi",
        "reporting",
        "email analytics"
    ],
    "homepage": "https://statusi.io",
    "authors": [
        {
            "name": "Statusi",
            "homepage": "https://statusi.io"
        }
    ],
    "support": {
        "issues": "https://github.com/jaldip/mautic-plugin-statusi/issues",
        "source": "https://github.com/jaldip/mautic-plugin-statusi"
    },
    "require": {
        "php": ">=8.2",
        "mautic/core-lib": "^7.0"
    },
    "extra": {
        "install-directory-name": "MauticStatusiBundle"
    }
